          "value": "estimated_difficulty IS NULL OR (length(trim(difficulty_estimate_note)) > 0 AND length(trim(difficulty_estimate_method)) > 0 AND difficulty_estimate_note IS NOT NULL AND difficulty_estimate_method IS NOT NULL)"
        },
        "summary_grant_evidence": {
          "name": "summary_grant_evidence",
          "value": "summary_sharing_permission <> 'granted' OR (summary IS NOT NULL AND length(trim(summary)) > 0 AND summary_basis IS NOT NULL AND summary_permission_note IS NOT NULL AND length(trim(summary_permission_note)) > 0)"
        }
      },
      "isRLSEnabled": false
    }
  },
